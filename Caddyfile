{
	# Global options
	auto_https disable_redirects
	skip_install_trust
}

# Reusable snippet for High-Speed Static SPA serving
(spa_static) {
	# Dynamic compression fallback for assets that are not precompressed
	encode zstd gzip

	# Cache fingerprinted immutable chunks for 1 year
	@immutable path /_app/immutable/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"

	# Avoid caching entrypoint HTML to ensure instant updates
	@entrypoint path *.html /
	header @entrypoint Cache-Control "no-cache, must-revalidate"

	# SPA client-side routing fallback
	try_files {path} /index.html
	file_server {
		# Line-speed direct streaming for pre-compressed Level 11 Brotli & Gzip assets
		precompressed br gzip
	}
}

# Reusable API reverse proxy to FastAPI backend (eliminates CORS)
(api_proxy) {
	handle /api/* {
		reverse_proxy localhost:8000
	}
}

# Admin Backoffice Static SPA (Port 5173, HTTP)
http://:5173 {
	root * ./apps/admin/build
	import api_proxy
	import spa_static
}

# Mobile POS Cashier Static SPA (Port 5174, HTTPS with internal TLS)
https://localhost:5174, https://127.0.0.1:5174, https://10.100.0.1:5174 {
	tls internal
	root * ./apps/pos/build
	import api_proxy
	import spa_static
}
