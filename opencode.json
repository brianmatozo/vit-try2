{
	"$schema": "https://opencode.ai/config.json",
	"permission": {
		"read": {
			"secrets/**": "deny",
			"**/*.pem": "deny",
			"confidential.txt": "deny",
			//"tests/**": "deny",
			//"apps/**": "deny",
			//"scripts/**": "deny",
			"node_modules/**": "deny",
			".venv/**": "deny"
		},
		"edit": {
			"critical-config.json": "deny",
			"legacy/**": "deny"
		}
	},
	"watcher": {
		"ignore": ["node_modules/**", "dist/**", ".git/**"]
	},
	"mcp": {
		"svelte": {
			"type": "local",
			"command": ["npx", "--force", "-y", "@sveltejs/mcp"]
		},
		"analyzer": {
			"type": "local",
			"command": ["uvx", "mcp-server-analyzer"],
			"enabled": false
		},
		"context7": {
			"type": "local",
			"command": ["npx", "-y", "@upstash/context7-mcp"],
			"enabled": false
		},
		"postgres": {
			"type": "local",
			"command": ["npx", "-y", "@microsoft/postgres-mcp", "run"],
			"enabled": false
		}
	}
}
